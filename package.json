{
  "name": "study-notes-hexo-particlex",
  "version": "1.0.0",
  "private": true,
  "description": "Hexo + ParticleX course-notes blog for GitHub Pages",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "hexo clean && hexo generate",
    "build:drafts": "hexo clean && hexo generate --draft",
    "preview": "hexo server --ip 127.0.0.1",
    "preview:drafts": "hexo server --draft --ip 127.0.0.1",
    "new": "hexo new",
    "publish:cse": "node tools/publish-cse.mjs",
    "import:cse": "node tools/import-notes.mjs",
    "configure": "node tools/configure.mjs"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@highlightjs/cdn-assets": "11.12.0",
    "@traptitech/markdown-it-katex": "3.6.0",
    "hexo": "7.3.0",
    "hexo-generator-archive": "2.0.0",
    "hexo-generator-category": "2.0.0",
    "hexo-generator-index": "4.0.0",
    "hexo-generator-tag": "2.0.0",
    "hexo-renderer-ejs": "2.0.0",
    "hexo-renderer-markdown-it": "7.1.1",
    "hexo-renderer-stylus": "3.0.1",
    "hexo-server": "3.0.0",
    "js-yaml": "4.1.0",
    "katex": "0.16.47",
    "mermaid": "12.3.0",
    "nunjucks": "3.2.4",
    "vue": "3.5.45"
  }
}
